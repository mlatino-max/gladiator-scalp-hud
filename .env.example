# Copy to .env (gitignored, never committed). Docker Compose reads it for the
# containers; nothing else does. Same key names as the alpaca-bot .env, so the
# two key lines can be copied from C:\Users\Matt\TOOLBOX\alpaca-bot\.env.
# PAPER keys only — the compose file forces paper mode on the MCP server and
# the HUD defaults to paper-api.alpaca.markets.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# One token gates every page and every /api/* route. Enter it once on /ops.
HUD_ACCESS_TOKEN=
# The cron sidecar sends this as "Authorization: Bearer ..." to the cron routes.
CRON_SECRET=

# Optional: ntfy-style push endpoint for TRADE_ARMED / gate flips / plumbing.
ALERT_PUSH_URL=
ALERT_PUSH_TOKEN=
GLADIATOR_EQUITY_CAP=750
ALPACA_DATA_FEED=iex

# Optional: restrict the MCP server. Empty = every toolset, including
# `trading` (paper orders), which is what the Render service exposed.
# Read-only desk:  ALPACA_TOOLSETS=account,assets,stock-data,news
ALPACA_TOOLSETS=

# Host-side knobs (compose interpolation only)
VAULT_PATH=../../GLADIATOR
HUD_BIND=0.0.0.0
HUD_PORT=3000
MCP_PORT=8000
VAULT_REFRESH_SECONDS=600
