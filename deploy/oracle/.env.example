# Copy to .env on the VM (chmod 600, never committed). Same key names as the
# local stack and the alpaca-bot .env. PAPER keys only: the HUD defaults to
# paper-api.alpaca.markets and has no order route.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# One token gates every page and every /api/* route. Enter it once on /ops.
HUD_ACCESS_TOKEN=
# The cron sidecar sends this as "Authorization: Bearer ..." to the cron routes.
CRON_SECRET=

# Public name Caddy serves and gets a certificate for. Any DNS name that points
# at the VM works; with no domain, use the free sslip.io form of the public IP:
# 129.146.1.2 -> 129-146-1-2.sslip.io
HUD_HOST=

# Optional, as on the PC
ALERT_PUSH_URL=
ALERT_PUSH_TOKEN=
GLADIATOR_EQUITY_CAP=750
ALPACA_DATA_FEED=iex
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
MASSIVE_API_KEY=

# Vault sync (defaults are right for this vault)
VAULT_REPO=git@github.com:mlatino-max/gladiator.git
VAULT_REF=master
VAULT_SYNC_SECONDS=600
VAULT_REFRESH_SECONDS=600
