# HTTPS front door for the HUD. Caddy fetches and renews the Let's Encrypt
# certificates for HUD_HOST and its www form on its own; the HUD never
# listens on a public port.
{$HUD_HOST} {
	encode gzip
	# Public, read-only Synaptic HUD feed (paper-desk state, no secrets): the
	# only path that is not behind HUD_ACCESS_TOKEN. Static files written by the
	# `feed` sidecar; nothing here reaches the HUD or the broker.
	handle_path /feed/* {
		root * /srv/feed
		header Cache-Control "no-store"
		header Access-Control-Allow-Origin "*"
		header X-Robots-Tag "noindex, nofollow"
		file_server
	}
	handle {
		reverse_proxy hud:3000
	}
}

www.{$HUD_HOST} {
	redir https://{$HUD_HOST}{uri} permanent
}
